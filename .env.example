# Dhara Realtors - WhatsApp Automation Configuration
# ----------------------------------------------------
# By default, local submissions are intercepted by the Vite dev server 
# and logged directly to the console with full delivery simulation.
#
# To connect to live WhatsApp Business API or Webhook providers:

# Option 1: Direct Webhook (Zapier / Make / Pabbly / Custom Gateway)
WHATSAPP_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/YOUR_WEBHOOK_ID/

# Option 2: Meta WhatsApp Cloud API (Graph API)
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_TEMPLATE_NAME=site_visit_confirmation

# Option 3: Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WA_FROM_NUMBER=whatsapp:+14155238886
